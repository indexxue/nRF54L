/*
 * MCUBoot console: same pins as app (TY rev_a / factory board).
 * Without this, MCUBoot uses DK defaults TX=P1.04 RX=P1.05 and APP
 * uses P1.09/P1.10 — Boot logs invisible on the app UART.
 */

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 10)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>,
				<NRF_PSEL(UART_RX, 1, 10)>;
			low-power-enable;
		};
	};
};

&uart20 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Avoid DK conflicts with our UART pins */
&pwm20 {
	status = "disabled";
};

&button1 {
	status = "disabled";
};
