/*
 * eink_tag — 当前硬件接线（内部 LFCLK RC；NFC/BLE 暂关）
 *
 * UART20: TX=P1.09  RX=P1.10  @ 115200
 * LED_G:  P1.05   LED_B: P1.04  (ACTIVE_LOW)
 * BTN1:   P0.00   BTN2:  P0.01  (ACTIVE_LOW)
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 10)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>,
				<NRF_PSEL(UART_RX, 1, 10)>;
			low-power-enable;
		};
	};
};

&uart20 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

/* DK PWM LED 占用 P1.10，与 UART RX 冲突 */
&pwm20 {
	status = "disabled";
};

&pwm_led1 {
	status = "disabled";
};

/* DK button1 占用 P1.09，与 UART TX 冲突 */
&button1 {
	status = "disabled";
};

/* led_scene：index0=R→LED_G，index1=B→LED_B */
&led0 {
	gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
	label = "LED_G P1.05";
};

&led1 {
	gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
	label = "LED_B P1.04";
};

&led2 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

/* 暂不用片上 NFCT */
&nfct {
	status = "disabled";
};

/ {
	zephyr,user {
		btn1-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
		btn2-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
	};
};
