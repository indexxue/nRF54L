/*
 * eink_tag — 硬件接线 rev_b（LFCLK=内部 RC；HFCLK=外部 32 MHz HFXO；BLE 开）
 *
 * 自有 PCB 脚表；勿烧到现网冒烟板（rev_a）。
 * 整表见 doc/board_io_rev_b.md
 *
 * UART20: TX=P1.04  RX=P1.05  @ 115200
 * LED_G:  P2.08   LED_B: P2.09  (ACTIVE_LOW)
 * BTN1:   P0.00   BTN2:  P0.01  (ACTIVE_LOW)
 * EPD SPI00: SCK=P2.01  MOSI=P2.02  MISO=P2.04  CS=P2.05
 * EPD GPIO:  DC=P2.00   RST=P2.03   BUSY=P2.07
 * PN5180 SPI22: SCK=P1.11 MOSI=P1.12 MISO=P1.13 NSS=P1.14
 * PN5180 GPIO:  IRQ=P0.02 BUSY=P1.08 RST=P1.07（常供电，无 PWR_ON）
 * ADC:    P1.06 AIN2（预留；本阶段不挂业务）
 * HFXO:   外部 32 MHz；片内负载 15 pF
 * P1.00/01：预留 LFXO（默认 NC）；P1.02/03：原 NFCT，仅数字备用
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 5)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>,
				<NRF_PSEL(UART_RX, 1, 5)>;
			low-power-enable;
		};
	};

	/* EPD：SCK=P2.01 MOSI=P2.02 MISO=P2.04。bitbang 时会 sleep 掉本组 */
	spi00_default: spi00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
			nordic,drive-mode = <NRF_DRIVE_E0E1>;
		};
	};

	spi00_sleep: spi00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
			low-power-enable;
		};
	};

	/* PN5180：SCK 必须为 P1 clock pin（P1.11） */
	spi22_default: spi22_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 12)>,
				<NRF_PSEL(SPIM_MISO, 1, 13)>;
		};
	};

	spi22_sleep: spi22_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 12)>,
				<NRF_PSEL(SPIM_MISO, 1, 13)>;
			low-power-enable;
		};
	};
};

&uart20 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

/* EPD：CS=P2.05；关掉 DK 板载 MX25 NOR */
&spi00 {
	status = "okay";
	cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi00_default>;
	pinctrl-1 = <&spi00_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi22 {
	status = "okay";
	cs-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi22_default>;
	pinctrl-1 = <&spi22_sleep>;
	pinctrl-names = "default", "sleep";
};

&mx25r64 {
	status = "disabled";
};

/* DK 默认外设：自有板脚已重排，关掉易冲突节点 */
&pwm20 {
	status = "disabled";
};

&pwm_led1 {
	status = "disabled";
};

&button1 {
	status = "disabled";
};

/* led_scene：index0=R→LED_G，index1=B→LED_B */
&led0 {
	gpios = <&gpio2 8 GPIO_ACTIVE_LOW>;
	label = "LED_G P2.08";
};

&led1 {
	gpios = <&gpio2 9 GPIO_ACTIVE_LOW>;
	label = "LED_B P2.09";
};

&led2 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

/* 本工程不用片上 NFCT Tag；读卡只走外挂 PN5180 */
&nfct {
	status = "disabled";
};

/* 外部 32 MHz HFXO；片内负载 15 pF；CONFIG_START_REQUEST_HFXO=y 强起 */
&hfxo {
	status = "okay";
	load-capacitors = "internal";
	/* 自制板无外挂电容：15pF 常温难起 → 17pF（与 zigbee_demo 对齐） */
	load-capacitance-femtofarad = <17000>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

/ {
	zephyr,user {
		/* 与 demo 一致：ACTIVE_LOW + 内部上拉；无上拉时浮空易误触双击→冷重启 */
		btn1-gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		btn2-gpios = <&gpio0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		epd-dc-gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;
		epd-rst-gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
		epd-busy-gpios = <&gpio2 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;

		/* PN5180 GPIO 仅 DT 登记；IRQ/BUSY 业务阶段再挂 */
		pn5180-busy-gpios = <&gpio1 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		pn5180-irq-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		pn5180-rst-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
	};
};
