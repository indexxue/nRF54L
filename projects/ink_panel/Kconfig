# ink_panel board feature options (sourced beside CMakeLists.txt).

config INK_PANEL_EPD
	bool "Enable e-ink panel"
	default y
	help
	  When disabled, epd_board / cbb/epd are not built and app skips
	  EPD refresh. Use prj.conf CONFIG_INK_PANEL_EPD=n to gate off.

config INK_PANEL_EPD_SPIM
	bool "EPD bus via SPIM20 (vs GPIO bitbang)"
	depends on INK_PANEL_EPD
	select SPI
	default n
	help
	  y: hardware SPIM20 on P1.08/P1.09, software CS on P1.10.
	  当前 NCS 3.2.0 上首次 spi_write 会 Precise bus fault，默认关。
	  n: GPIO bitbang（与 eink_tag EPD_USE_BITBANG=1 同路径）。

config INK_PANEL_NFC
	bool "Enable on-chip NFCT Type 2 Tag"
	default y
	help
	  When enabled, builds nfc_board and starts T2T emulation with a fixed
	  NDEF Text payload. Use prj.conf CONFIG_INK_PANEL_NFC=n to gate off.

config INK_PANEL_W25Q
	bool "Enable W25Q64 external SPI NOR (SPIM00)"
	select SPI
	default y
	help
	  When enabled, builds w25q_board + cbb/w25q for page slots.
	  Pins: SCK=P2.06 MOSI=P2.08 MISO=P2.09 CS=P2.10 WP=P2.05 HOLD=P2.04.
	  Uses spi00 (SERIAL00; disables uart00; RTT log).

config INK_PANEL_CAP1203
	bool "Enable CAP1203 capacitive touch (CS1=L / CS2=R)"
	select I2C
	default y
	help
	  γ HMI：CS1 模内翻页，CS2 切模 home→notes→info。
	  与 nPM1300 共 i2c21；ALERT=P0.01。

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
