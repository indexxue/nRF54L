# Zigbee ED / board feature options (sourced beside CMakeLists.txt).

config INK_PANEL_EPD
	bool "Enable e-ink panel (bitbang + smoke bringup)"
	default y
	help
	  When disabled, epd_board / cbb/epd are not built and app skips
	  EPD smoke/refresh. Use prj.conf CONFIG_INK_PANEL_EPD=n to gate off.

config INK_PANEL_NFC
	bool "Enable on-chip NFCT Type 2 Tag smoke"
	default y
	help
	  When enabled, builds nfc_board and starts T2T emulation with a fixed
	  NDEF Text payload for EVT field/read smoke. Use prj.conf
	  CONFIG_INK_PANEL_NFC=n to gate off.

config ZIGBEE_APP_TX_POWER
	int "Zigbee TX power (dBm)"
	range -40 8
	default 8
	help
	  Transmit power applied to each channel in CONFIG_ZIGBEE_CHANNEL_MASK
	  after zigbee_enable(). Session is compile-time only (not Settings).

config ZIGBEE_ED_MANUFACTURER
	string "ZCL Basic ManufacturerName"
	default "TY"
	help
	  Length-prefixed on the air (max 31 chars). Must match
	  doc/tuya_ed_zcl_mapping.md when Tuya requires a fixed value.

config ZIGBEE_ED_MODEL
	string "ZCL Basic ModelIdentifier"
	default "ink_panel"
	help
	  Length-prefixed on the air (max 31 chars). Align with product name
	  or PID per doc/tuya_ed_zcl_mapping.md.

config ZIGBEE_ED_APP_VERSION
	hex "ZCL Basic ApplicationVersion"
	range 0 0xff
	default 0x01
	help
	  Single-byte Basic ApplicationVersion attribute.

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
