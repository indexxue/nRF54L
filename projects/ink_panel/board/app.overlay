/*
 * ink_panel — EVT netlist (Netlist_Schematic1_2026-11-05)
 *
 * UART00: 与 spi00 互斥；NOR 占 SERIAL00 时关掉（日志走 RTT）
 * EPD:    SPIM20 SCK=P1.08 MOSI=P1.09；CS=P1.10 软件拉；DC/RST/BUSY GPIO；无 MISO
 * I2C21:  SCL=P1.11 SDA=P1.12 (nPM1300 + CAP1203)
 * NOR:    SPIM00 SCK=P2.06 MOSI=P2.08 MISO=P2.09；CS=P2.10 软件拉；WP=P2.05 HOLD=P2.04
 *         （P2 属 SERIAL00；spi21 与 i2c21 互斥；勿把 MISO 放进 E0E1 组）
 * LED0:   P1.13 ACTIVE_LOW   (LED_STATUS_N)
 * BTN1:   P0.00 ACTIVE_LOW   (BTN_USER_N); no BTN2 (P0.01 = TOUCH_ALERT)
 *
 * Must disable DK leftovers: button0 shares P1.13 with LED; button1/2 on
 * P1.09/P1.08；pwm20 on P1.10；mx25r64（DK 片上 NOR，EVT 无）。
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	uart00_default: uart00_default {
		group1 {
			/* QFN48 dedicated: UARTE TXD = P2.02 (not P2.01) */
			psels = <NRF_PSEL(UART_TX, 2, 2)>;
		};
		group2 {
			/* QFN48 dedicated: UARTE RXD = P2.00 */
			psels = <NRF_PSEL(UART_RX, 2, 0)>;
			bias-pull-up;
		};
	};

	uart00_sleep: uart00_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 2)>,
				<NRF_PSEL(UART_RX, 2, 0)>;
			low-power-enable;
		};
	};

	/* EVT I²C → nPM1300 (+ CAP1203)；SCL=P1.11 SDA=P1.12；外置 4.7k 上拉 */
	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 11)>,
				<NRF_PSEL(TWIM_SDA, 1, 12)>;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 11)>,
				<NRF_PSEL(TWIM_SDA, 1, 12)>;
			low-power-enable;
		};
	};

	/* EPD SPIM20：SCK 必须 Clock pin P1.08；TX-only 不绑 MISO */
	spi20_default: spi20_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 8)>,
				<NRF_PSEL(SPIM_MOSI, 1, 9)>;
			nordic,drive-mode = <NRF_DRIVE_E0E1>;
		};
	};

	spi20_sleep: spi20_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 8)>,
				<NRF_PSEL(SPIM_MOSI, 1, 9)>;
			low-power-enable;
		};
	};

	/*
	 * W25Q64 on SPIM00（P2 clock pin P2.06）。
	 * MISO 单独一组、不加 E0E1——输入脚不可与 SCK/MOSI 同 drive-mode。
	 */
	spi00_nor_default: spi00_nor_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MISO, 2, 9)>;
		};
		group2 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 6)>,
				<NRF_PSEL(SPIM_MOSI, 2, 8)>;
			nordic,drive-mode = <NRF_DRIVE_E0E1>;
		};
	};

	spi00_nor_sleep: spi00_nor_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 6)>,
				<NRF_PSEL(SPIM_MISO, 2, 9)>,
				<NRF_PSEL(SPIM_MOSI, 2, 8)>;
			low-power-enable;
		};
	};

};

/* SERIAL00：NOR 用 spi00，必须关 uart00（与 spi00 互斥）；日志走 RTT */
&uart00 {
	status = "disabled";
};

&uart20 {
	status = "disabled";
};

&spi20 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi20_default>;
	pinctrl-1 = <&spi20_sleep>;
	pinctrl-names = "default", "sleep";
	/* CS=P1.10 由 epd_board 软件控制，不挂 cs-gpios */
};

&i2c21 {
	status = "okay";
	compatible = "nordic,nrf-twim";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm20 {
	status = "disabled";
};

&pwm_led1 {
	status = "disabled";
};

/* DK buttons: button0 == P1.13 == our LED — must all be off */
&button0 {
	status = "disabled";
};

&button1 {
	status = "disabled";
};

&button2 {
	status = "disabled";
};

&button3 {
	status = "disabled";
};

&led0 {
	gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
	label = "LED_STATUS P1.13";
};

&led1 {
	status = "disabled";
};

&led2 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

/* 冒烟轮关掉 NFCT；开 NFC 时再 okay */
&nfct {
	status = "disabled";
};

/* EVT 外挂 W25Q64：占 SERIAL00；CS 由 w25q_board 软件拉 */
&spi00 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi00_nor_default>;
	pinctrl-1 = <&spi00_nor_sleep>;
	pinctrl-names = "default", "sleep";
};

/* DK 片上 MX25 — EVT 无此器件 */
&mx25r64 {
	status = "disabled";
};

/* 临时关外部晶振（排查无灯效）；恢复射频时再 okay + 负载电容 */
&hfxo {
	status = "disabled";
};

&lfxo {
	status = "disabled";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

/ {
	/* 控制台走 RTT；uart00 已让给 spi00 */
	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
	};

	zephyr,user {
		btn1-gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* EVT: EPD_PWR_EN→LS2；TOUCH_LDO_EN→LDO1；ALERT# OD 低有效 */
		epd-pwr-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		touch-ldo-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		touch-alert-gpios = <&gpio0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* EPD：CS/DC/RST/BUSY GPIO；SCK/MOSI 供 bitbang 回退（SPIM 关时） */
		epd-sck-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
		epd-mosi-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		epd-cs-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
		epd-dc-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
		epd-rst-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
		/* 对齐 eink_tag：BUSY 内部上拉；无面板时也应读到高 */
		epd-busy-gpios = <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		/* W25Q64：CS 软件；WP/HOLD 驱高（板载 15k 上拉兜底） */
		flash-cs-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
		flash-wp-gpios = <&gpio2 5 GPIO_ACTIVE_HIGH>;
		flash-hold-gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
	};
};
