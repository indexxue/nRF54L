/*
 * demo — 最小冒烟脚表（对齐自有板 UART/LED；与 board_io_rev_b 一致）
 *
 * UART20 console: TX=P1.04  RX=P1.05  @ 115200
 * LED0=P2.08  LED1=P2.09  (GPIO_ACTIVE_LOW)
 * FTM 按键：P0.00 ACTIVE_LOW + PULL_UP（BTN_PERMISSION_FTM）
 * LFCLK: 内部 RC；HFCLK: 外部 32 MHz HFXO（CONFIG_START_REQUEST_HFXO）
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 5)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>,
				<NRF_PSEL(UART_RX, 1, 5)>;
			low-power-enable;
		};
	};
};

&uart20 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

/* DK 默认外设关掉，避免占脚 */
&pwm20 {
	status = "disabled";
};

&pwm_led1 {
	status = "disabled";
};

&button1 {
	status = "disabled";
};

&led0 {
	gpios = <&gpio2 8 GPIO_ACTIVE_LOW>;
	label = "LED0 P2.08";
};

&led1 {
	gpios = <&gpio2 9 GPIO_ACTIVE_LOW>;
	label = "LED1 P2.09";
};

&led2 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

/* 外部 32 MHz HFXO；片内负载 15 pF；start_boot 请求并保持 */
&hfxo {
	status = "okay";
	load-capacitors = "internal";
	/* 自制板无外挂电容：与 zigbee_demo 对齐内部 17pF */
	load-capacitance-femtofarad = <17000>;
};

/* FTM 跳槽：P0.00 低有效，内部上拉 */
&gpio0 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

/ {
	zephyr,user {
		btn-ftm-gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};
