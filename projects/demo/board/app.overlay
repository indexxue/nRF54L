/*
 * demo — TY rev_a pin map (borrow nrf54l15dk SoC target until custom board exists).
 *
 * UART20 console: TX=P1.09  RX=P1.10  @ 115200
 * LED0=P1.04  LED1=P1.05  (GPIO_ACTIVE_LOW；若常亮/不亮可改 ACTIVE_HIGH)
 * FTM 按键：P0.00 ACTIVE_LOW + PULL_UP（BTN_PERMISSION_FTM）
 * LFCLK: 工程 prj.conf 使用 RC（内部），不依赖外部 32k 晶振
 * HF: 无 BLE 时走内部 HFINT，不强制起 HFXO
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 10)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>,
				<NRF_PSEL(UART_RX, 1, 10)>;
			low-power-enable;
		};
	};
};

&uart20 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

/* DK 默认 PWM LED 占用 P1.10，与 UART RX 冲突 */
&pwm20 {
	status = "disabled";
};

&pwm_led1 {
	status = "disabled";
};

/* DK button1 占用 P1.09，与 UART TX 冲突 */
&button1 {
	status = "disabled";
};

&led0 {
	gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
	label = "LED0 P1.04";
};

&led1 {
	gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
	label = "LED1 P1.05";
};

&led2 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

/* FTM 跳槽：P0.00 低有效，内部上拉 */
&gpio0 {
	status = "okay";
};

/ {
	zephyr,user {
		btn-ftm-gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};
