/*
 * zigbee_ed — eink_tag rev_b GPIO + Zigbee R23 + EPD 4.2"（bit-bang）
 *
 * UART20: TX=P1.04  RX=P1.05
 * LED_G/B: P2.08 / P2.09 ACTIVE_LOW
 * BTN1/2:  P0.00 / P0.01 ACTIVE_LOW + PULL_UP
 * EPD:     SCK=P2.01 MOSI=P2.02 CS=P2.05 DC=P2.00 RST=P2.03 BUSY=P2.07
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/* 分区由 Partition Manager / pm_static.yml（MCUBoot + zboss）管理 */

&pinctrl {
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 5)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>,
				<NRF_PSEL(UART_RX, 1, 5)>;
			low-power-enable;
		};
	};
};

&uart20 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

/* EPD 用 GPIO bit-bang；关掉 DK NOR，避免占脚 */
&spi00 {
	status = "disabled";
};

&mx25r64 {
	status = "disabled";
};

/* MCUBoot：勿扩到 1524KB（否则 PM 在 0x165000 后多出 gap）。用板级默认 1428KB。 */

&pwm20 {
	status = "disabled";
};

&pwm_led1 {
	status = "disabled";
};

&button1 {
	status = "disabled";
};

&led0 {
	gpios = <&gpio2 8 GPIO_ACTIVE_LOW>;
	label = "LED_G P2.08";
};

&led1 {
	gpios = <&gpio2 9 GPIO_ACTIVE_LOW>;
	label = "LED_B P2.09";
};

&led2 {
	status = "disabled";
};

&led3 {
	status = "disabled";
};

&nfct {
	status = "disabled";
};

&hfxo {
	status = "okay";
	/* 无外挂电容：自制板 15pF 常温难起、升温才振 → 先拉满内部上限 17pF。
	 * 最终应按晶振规格书 CL 微调（合法步进 250fF，最大 17000）。 */
	load-capacitors = "internal";
	load-capacitance-femtofarad = <17000>;
};

&timer20 {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

/ {
	chosen {
		ncs,zigbee-timer = &timer20;
	};

	zephyr,user {
		btn1-gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		btn2-gpios = <&gpio0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		/* rev_b EPD：DC/RST/BUSY 走 DT；SCK/MOSI/CS 在 epd_board 内 bit-bang */
		epd-dc-gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;
		epd-rst-gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
		epd-busy-gpios = <&gpio2 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	};
};
