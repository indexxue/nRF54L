# Copy to nrf.env and edit. nrf.env is gitignored.

# nRF Connect SDK version tag (3.2.x line)
NCS_VERSION=v3.2.0

# SDK install root (must contain zephyr/, nrf/, etc.)
NCS_ROOT=D:\ncs\v3.2.0

# Default board target (application core)
# Custom PCB: replace after adding boards/ definition.
BOARD=nrf54l15dk/nrf54l15/cpuapp

# Default project under projects/
PROJECT=demo

# Chip short name for firmware/ archive filenames
CHIP_NAME=nrf54l15

# Flash runner — SWD via J-Link (not UART)
FLASH_RUNNER=jlink

# 1 = wrap west via: nrfutil sdk-manager toolchain launch --ncs-version ...
# 0 = call west from current PATH (advanced; ZEPHYR_BASE must be set)
USE_NRFUTIL_LAUNCH=1

# Zigbee R23 add-on root (ncs-zigbee). Required for -Project zigbee_demo
# NCS_ZIGBEE_ROOT=D:\ncs\tmp\ncs-zigbee
